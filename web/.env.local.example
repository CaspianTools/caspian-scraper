# Copy this file to .env.local and fill in the values.
# See web/README.md for where each value comes from.
#
# IMPORTANT: .env.local is gitignored by default. Never commit secret values.

# ---- GitHub App ----
# Public slug (used to build the install URL). Lowercase, hyphenated.
NEXT_PUBLIC_GITHUB_APP_SLUG=caspian-scraper-app

# Numeric App ID from github.com/settings/apps/<your-app>
GITHUB_APP_ID=

# Paste the PEM private key in one line, with newlines escaped as \n.
# Example: GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMII...\n-----END RSA PRIVATE KEY-----\n"
GITHUB_APP_PRIVATE_KEY=

# ---- Firebase Admin SDK (server-side) ----
# Service-account credentials, downloaded from Firebase Console → Project
# Settings → Service Accounts → Generate new private key (JSON).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Same one-line PEM convention as above.
FIREBASE_PRIVATE_KEY=

# ---- Firebase client SDK (public, baked into the JS bundle) ----
# Firebase Console → Project Settings → General → Your apps → Web app config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
