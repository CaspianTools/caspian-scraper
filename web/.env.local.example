# Copy this file to .env.local and fill in the values.
# See web/README.md for where each value comes from.
#
# IMPORTANT: .env.local is gitignored by default. Never commit secret values.

# ---- Access control ----
# Who can sign in. Anyone not listed is refused a session even with a valid
# Google token. Fail-closed: leave SUPER_ADMIN_EMAIL blank and NOBODY gets in.
#
# These are for LOCAL DEV ONLY. The live site at scraper.caspiantools.com does
# not read this file — its values live in web/apphosting.yaml and take effect
# on the next App Hosting deploy.
#
# The workspace owner. Their Firebase uid is the owner_uid on all existing
# data, and admins are aliased onto it so they see the same workspace.
SUPER_ADMIN_EMAIL=
# Comma-separated. Full access, except managing the AI provider key.
# Must be the exact address each person signs in to Google with.
ADMIN_EMAILS=

# ---- Firebase Admin SDK (server-side) ----
# Service-account credentials, from Firebase Console → Project Settings →
# Service accounts → Generate new private key (JSON).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# One-line PEM. Example:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# ---- Firebase client SDK (public, baked into the JS bundle) ----
# Firebase Console → Project Settings → General → Your apps → Web app config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firestore (optional: dedicated database name) ----
# Set to "scraper" to point this app at its own isolated Firestore database
# within the Firebase project. Leave blank for the default DB.
FIRESTORE_DATABASE_ID=

# Client-side copy of the database id. Must match FIRESTORE_DATABASE_ID.
# Defaults to "scraper" in code when unset.
# NOTE: currently unused — it backed the AI-config wizard's onSnapshot reads,
# which were replaced by route polling in 9291b87.
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=scraper

# ---- GitHub workflow_dispatch (optional but recommended) ----
# Fine-grained Personal Access Token with Actions: read+write scoped to
# the caspian-scraper repo. Used to trigger the scrape-due workflow the
# moment a user clicks "Run scrape now" (otherwise they wait up to 15
# minutes for the cron). Create at:
#   https://github.com/settings/personal-access-tokens/new
# Without this, queued requests still run on the cron tick — just slower.
GH_DISPATCH_TOKEN=
