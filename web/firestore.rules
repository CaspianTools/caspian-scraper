rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A user can read and update their own profile doc. Writes are limited
    // to the prefs subobject — installation_id, fork, email are bot-managed
    // and must be written by the backend via the admin SDK (which bypasses
    // these rules).
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['prefs']);
      allow create, delete: if false;

      // Caches are server-only. Admin SDK writes bypass these rules.
      match /{cache=**} {
        allow read, write: if false;
      }
    }
  }
}
